{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fde-academy",
  "main": "./fde-cloudflare-entry.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
